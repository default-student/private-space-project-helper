            android:icon="@drawable/ic_project_link"
            android:targetActivity=".ProjectLinkActivity">
            <intent-filter><action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".ProjectLink07" android:enabled="false"
